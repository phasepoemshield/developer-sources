-   private List<FunTimeEventData> visibleCards(FunTimeEventScanner scanner, String searchQuery) {
-      if (scanner == null) {
-         return List.of();
-      }
-
-      Set<Integer> selected = new HashSet<>(this.config.selectedAnarchies());
-      if (selected.isEmpty()) {
-         return List.of();
-      }
-
-      String query = searchQuery == null ? "" : searchQuery.trim().toLowerCase(Locale.ROOT);
-      List<FunTimeEventData> cards = new ArrayList<>();
-      for (FunTimeEventData data : scanner.getStorage().snapshot()) {
-         if (!selected.contains(data.getAnarchyNumber()) || !data.hasEvent()) {
-            continue;
-         }
-
-         if (!query.isEmpty() && !matchesSearch(data, query)) {
-            continue;
-         }
-
-         cards.add(data);
-      }
-
-      cards.sort((a, b) -> {
-         int phaseA = phasePriority(a);
-         int phaseB = phasePriority(b);
-         if (phaseA != phaseB) {
-            return Integer.compare(phaseA, phaseB);
-         }
-
-         boolean nextA = a.getEventType() == FunTimeEventType.NEXT_EVENT;
-         boolean nextB = b.getEventType() == FunTimeEventType.NEXT_EVENT;
-         if (nextA != nextB) {
-            return nextA ? 1 : -1;
-         }
-
-         long remainingA = a.getEffectiveRemainingMs(System.currentTimeMillis());
-         long remainingB = b.getEffectiveRemainingMs(System.currentTimeMillis());
-         long safeA = remainingA >= 0L ? remainingA : Long.MAX_VALUE;
-         long safeB = remainingB >= 0L ? remainingB : Long.MAX_VALUE;
-         int byTimer = Long.compare(safeA, safeB);
-         return byTimer != 0 ? byTimer : Integer.compare(a.getAnarchyNumber(), b.getAnarchyNumber());
-      });
-      return cards;
-   }
-
-   private static boolean matchesSearch(FunTimeEventData data, String query) {
