-   private static String formatTimerLine(FunTimeEventData data, long nowMs) {
-      long remaining = data.getEffectiveRemainingMs(nowMs);
-      if (remaining > 0L) {
-         return "Появится через " + formatDuration(remaining);
-      }
-
-      return switch (data.getStatus()) {
-         case RUNNING -> "Ивент идёт сейчас";
-         case LOOTING -> "Можно лутать";
-         case STARTING, ACTIVATING -> "Скоро начнётся";
-         case WAITING, OPENED -> "Ожидание фазы";
-         case STOPPING -> "Заканчивается";
-         default -> "Ожидание";
