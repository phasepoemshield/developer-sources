-#!/bin/sh
-set -eu
-
-LABEL="app.flukeswitches.license-server"
-SOURCE_DIR="$(cd "$(dirname "$0")" && pwd)"
-SERVER_DIR="$HOME/Library/Application Support/FlukeSwitches/license-server"
-PLIST_DIR="$HOME/Library/LaunchAgents"
-PLIST_PATH="$PLIST_DIR/$LABEL.plist"
-ENV_FILE="$SERVER_DIR/.env"
-LOG_DIR="$SERVER_DIR/logs"
-
-mkdir -p "$PLIST_DIR" "$SERVER_DIR/data" "$LOG_DIR"
-
-cp "$SOURCE_DIR/server.js" "$SERVER_DIR/server.js"
-cp "$SOURCE_DIR/package.json" "$SERVER_DIR/package.json"
-cp "$SOURCE_DIR/.env.example" "$SERVER_DIR/.env.example"
-cp "$SOURCE_DIR/data/schema.sql" "$SERVER_DIR/data/schema.sql"
-if [ -f "$SOURCE_DIR/data/license.sqlite" ] && [ ! -f "$SERVER_DIR/data/license.sqlite" ]; then
-  cp "$SOURCE_DIR/data/license.sqlite" "$SERVER_DIR/data/license.sqlite"
-fi
-
-if [ ! -f "$ENV_FILE" ]; then
-  cp "$SOURCE_DIR/.env.example" "$ENV_FILE"
-fi
-
-cat > "$SERVER_DIR/start-license-server.sh" <<START
-#!/bin/sh
-set -eu
-
-SERVER_DIR="$SERVER_DIR"
-ENV_FILE="\$SERVER_DIR/.env"
-
-if [ -f "\$ENV_FILE" ]; then
-  set -a
-  . "\$ENV_FILE"
-  set +a
-fi
-
-cd "\$SERVER_DIR"
-exec /usr/local/bin/node server.js
-START
-chmod +x "$SERVER_DIR/start-license-server.sh"
-
-cat > "$PLIST_PATH" <<PLIST
-<?xml version="1.0" encoding="UTF-8"?>
-<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
-<plist version="1.0">
-<dict>
-  <key>Label</key>
-  <string>$LABEL</string>
-  <key>ProgramArguments</key>
-  <array>
-    <string>$SERVER_DIR/start-license-server.sh</string>
-  </array>
-  <key>WorkingDirectory</key>
-  <string>$SERVER_DIR</string>
-  <key>RunAtLoad</key>
-  <true/>
-  <key>KeepAlive</key>
-  <true/>
-  <key>StandardOutPath</key>
-  <string>$LOG_DIR/license-server.log</string>
-  <key>StandardErrorPath</key>
-  <string>$LOG_DIR/license-server.err.log</string>
-</dict>
-</plist>
-PLIST
-
-launchctl bootout "gui/$(id -u)" "$PLIST_PATH" 2>/dev/null || true
-launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
-launchctl enable "gui/$(id -u)/$LABEL"
-launchctl kickstart -k "gui/$(id -u)/$LABEL"
-
-echo "License server autostart installed."
-echo "Admin panel: http://127.0.0.1:8080/admin/keys"
-echo "Config: $ENV_FILE"
-echo "Logs: $LOG_DIR"
