-const express = require("express");
-const cors = require("cors");
-const crypto = require("crypto");
-const fs = require("fs");
-const path = require("path");
-
-const app = express();
-const PORT = Number(process.env.PORT || 8080);
-const DB_PATH = path.join(__dirname, "db.json");
-const ADMIN_USERNAME = "admin";
-const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || "change-me";
-
-if (!process.env.ADMIN_PASSWORD) {
-  console.warn("WARNING: ADMIN_PASSWORD is not set. Temporary admin password is 'change-me'.");
-}
-
-app.use(cors());
-app.use(express.json());
-app.use(express.urlencoded({ extended: false }));
-
-function nowIso() {
-  return new Date().toISOString();
-}
-
-function defaultDb() {
-  return {
-    keys: {},
-    builds: {
-      "test-beta-001": {
-        status: "active",
-        type: "beta",
-        createdAt: nowIso(),
-        reason: null,
-      },
-    },
-  };
-}
-
-function isObject(value) {
-  return value !== null && typeof value === "object" && !Array.isArray(value);
-}
-
-function normalizeDate(value) {
-  if (value === null || value === undefined || value === "") return null;
-  if (typeof value === "number") return new Date(value).toISOString();
-
-  const date = new Date(value);
-  if (Number.isNaN(date.getTime())) return null;
-  return date.toISOString();
-}
-
-function normalizeDb(data) {
-  const fallback = defaultDb();
-  const db = isObject(data) ? data : {};
-
-  if (!isObject(db.keys)) db.keys = {};
-  if (!isObject(db.builds)) db.builds = {};
-
-  if (!db.builds["test-beta-001"]) {
-    db.builds["test-beta-001"] = fallback.builds["test-beta-001"];
-  }
-
-  for (const key of Object.keys(db.keys)) {
-    const license = isObject(db.keys[key]) ? db.keys[key] : {};
-    db.keys[key] = {
-      status: license.status === "disabled" ? "disabled" : "active",
-      hwid: license.hwid || license.hwid_hash || null,
-      username: license.username || null,
-      uuid: license.uuid || null,
-      buildId: license.buildId || null,
-      expiresAt: normalizeDate(license.expiresAt),
-      activatedAt: normalizeDate(license.activatedAt),
-      lastSeenAt: normalizeDate(license.lastSeenAt),
-      note: license.note || license.comment || null,
-    };
-  }
-
-  for (const buildId of Object.keys(db.builds)) {
-    const build = isObject(db.builds[buildId]) ? db.builds[buildId] : {};
-    db.builds[buildId] = {
-      status: build.status === "disabled" ? "disabled" : "active",
-      type: build.type || "beta",
-      createdAt: normalizeDate(build.createdAt) || nowIso(),
-      reason: build.reason || null,
-    };
-  }
-
-  return db;
-}
-
-function readDb() {
-  if (!fs.existsSync(DB_PATH)) {
-    const db = defaultDb();
-    writeDb(db);
-    return db;
-  }
-
-  const raw = fs.readFileSync(DB_PATH, "utf8");
-  return normalizeDb(JSON.parse(raw));
-}
-
-function writeDb(db) {
-  fs.writeFileSync(DB_PATH, JSON.stringify(normalizeDb(db), null, 2) + "\n");
-}
-
-function hideKey(key) {
-  if (!key || key.length < 4) return "****";
-  return "****" + key.slice(-4);
-}
-
-function cleanString(value) {
-  if (typeof value !== "string") return "";
-  return value.trim();
-}
-
-function parseDays(value) {
-  const days = Number(value);
-  if (!Number.isFinite(days) || days <= 0) return 2;
-  return days;
-}
-
-function expiresAtFromDays(days) {
-  return new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();
-}
-
-function randomPart() {
-  const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
-  let part = "";
-
-  for (let i = 0; i < 4; i += 1) {
-    part += alphabet[crypto.randomInt(alphabet.length)];
-  }
-
-  return part;
-}
-
-function generateLicenseKey(db) {
-  let key;
-
-  do {
-    key = `FLUKE-BETA-${randomPart()}-${randomPart()}-${randomPart()}`;
-  } while (db.keys[key]);
-
-  return key;
-}
-
-function dateTime(value) {
-  const date = normalizeDate(value);
-  if (!date) return "";
-  return date;
-}
-
-function isExpired(license) {
-  const expiresAt = new Date(license.expiresAt).getTime();
-  return Number.isFinite(expiresAt) && Date.now() > expiresAt;
-}
-
-function licenseStatus(license) {
-  if (license.status === "disabled") return "disabled";
-  if (isExpired(license)) return "expired";
-  return "active";
-}
-
-function shortValue(value) {
-  if (!value) return "";
-  if (value.length <= 14) return value;
-  return `${value.slice(0, 8)}...${value.slice(-4)}`;
-}
-
-function escapeHtml(value) {
-  return String(value ?? "")
-    .replace(/&/g, "&amp;")
-    .replace(/</g, "&lt;")
-    .replace(/>/g, "&gt;")
-    .replace(/"/g, "&quot;")
-    .replace(/'/g, "&#39;");
-}
-
-function redirectAdmin(res, message) {
-  const suffix = message ? `?message=${encodeURIComponent(message)}` : "";
-  res.redirect(`/admin${suffix}`);
-}
-
-function unauthorized(res) {
-  res.set("WWW-Authenticate", 'Basic realm="Fluke Admin"');
-  return res.status(401).send("Authentication required");
-}
-
-function safeEqual(a, b) {
-  const left = Buffer.from(a);
-  const right = Buffer.from(b);
-  return left.length === right.length && crypto.timingSafeEqual(left, right);
-}
-
-function basicAuth(req, res, next) {
-  const header = req.headers.authorization || "";
-  if (!header.startsWith("Basic ")) return unauthorized(res);
-
-  let username = "";
-  let password = "";
-
-  try {
-    const decoded = Buffer.from(header.slice(6), "base64").toString("utf8");
-    const separator = decoded.indexOf(":");
-    username = separator >= 0 ? decoded.slice(0, separator) : decoded;
-    password = separator >= 0 ? decoded.slice(separator + 1) : "";
-  } catch (error) {
-    return unauthorized(res);
-  }
-
-  if (!safeEqual(username, ADMIN_USERNAME) || !safeEqual(password, ADMIN_PASSWORD)) {
-    return unauthorized(res);
-  }
-
-  return next();
-}
-
-function renderActionButton(label, key, action, danger = false) {
