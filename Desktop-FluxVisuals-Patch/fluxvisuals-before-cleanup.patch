-async function poll(token) {
-  const batches = chunk(knownServerIds(), BATCH_SIZE);
-  const merged = [];
-  let ok = false;
-
-  for (const batch of batches) {
-    try {
-      const part = await fetchBatch(token, batch);
-      merged.push(...part);
-      ok = true;
-    } catch (error) {
-      console.warn(`[events] batch failed: ${error.message}`);
-    }
-  }
-
-  if (ok) {
-    cache = { success: true, updatedAt: Date.now(), response: merged };
-  }
-}
-
-function startPolling() {
-  const token = (process.env.FUNTIME_API_TOKEN || "").trim();
-  if (!token) {
-    console.warn("[events] FUNTIME_API_TOKEN is not set, /api/events will be empty.");
-    return;
-  }
-
-  let intervalMs = Number(process.env.FUNTIME_EVENTS_POLL_MS);
-  if (!Number.isFinite(intervalMs) || intervalMs < MIN_POLL_MS) {
-    intervalMs = DEFAULT_POLL_MS;
-  }
-
-  const run = () => {
-    poll(token).catch((error) => console.warn(`[events] poll failed: ${error.message}`));
-  };
-
-  run();
-  pollTimer = setInterval(run, intervalMs);
-  if (pollTimer.unref) pollTimer.unref();
-  console.log(`[events] relay polling every ${intervalMs}ms`);
-}
-
-function mount(app) {
-  app.get("/api/events", (req, res) => {
-    res.json(cache);
-  });
-  startPolling();
-}
-
