diff --git a/backend/license-server/funtime-events.js b/backend/license-server/funtime-events.js
deleted file mode 100644
index e613026..0000000
--- a/backend/license-server/funtime-events.js
+++ /dev/null
@@ -1,128 +0,0 @@
-/**
- * FunTime events relay.
- *
- * Holds a single FunTime API token server-side, polls api.funtime.su for every
- * known anarchy, caches the merged response, and serves it publicly at
- * GET /api/events so any FluxVisuals client can read events without its own token.
- *
- * Env:
- *   FUNTIME_API_TOKEN       required, the FunTime Authorization-Token.
- *   FUNTIME_EVENTS_POLL_MS  optional, poll interval in ms (default 30000, min 10000).
- */
-
-const EVENTS_INFO_URL = "https://api.funtime.su/method/events-info";
-const BATCH_SIZE = 30;
-const REQUEST_TIMEOUT_MS = 5000;
-const DEFAULT_POLL_MS = 30000;
-const MIN_POLL_MS = 10000;
-
-// Mirrors FunTimeScanConfig ranges on the client.
-const ANARCHY_RANGES = [
-  [101, 115],
-  [201, 236],
-  [301, 325],
-  [501, 516],
-  [901, 904],
-];
-
-// success stays true with an empty list until the first poll lands, so clients
-// show "no events" rather than an error during the startup window.
-let cache = { success: true, updatedAt: 0, response: [] };
-let pollTimer = null;
-
-function knownServerIds() {
-  const ids = [];
-  for (const [from, to] of ANARCHY_RANGES) {
-    for (let n = from; n <= to; n += 1) {
-      ids.push("anarchy" + n);
-    }
-  }
-  return ids;
-}
-
-function chunk(list, size) {
-  const out = [];
-  for (let i = 0; i < list.length; i += size) {
-    out.push(list.slice(i, i + size));
-  }
-  return out;
-}
-
-async function fetchBatch(token, serverIds) {
-  // Raw commas, matching the request format the owner client uses against FunTime.
-  const url = `${EVENTS_INFO_URL}?event-type=all&server-type=${serverIds.join(",")}`;
-  const controller = new AbortController();
-  const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
-
-  try {
-    const res = await fetch(url, {
-      method: "GET",
-      headers: { "Authorization-Token": token },
-      signal: controller.signal,
-    });
-
-    if (!res.ok) {
-      throw new Error(`HTTP ${res.status}`);
-    }
-
-    const json = await res.json();
-    if (json && json.success === false) {
-      throw new Error(json["error-message"] || "upstream error");
-    }
-
-    return Array.isArray(json.response) ? json.response : [];
-  } finally {
-    clearTimeout(timeout);
-  }
-}
-
-async function poll(token) {
-  const batches = chunk(knownServerIds(), BATCH_SIZE);
-  const merged = [];
-  let ok = false;
-
-  for (const batch of batches) {
-    try {
-      const part = await fetchBatch(token, batch);
-      merged.push(...part);
-      ok = true;
-    } catch (error) {
-      console.warn(`[events] batch failed: ${error.message}`);
-    }
-  }
-
-  if (ok) {
-    cache = { success: true, updatedAt: Date.now(), response: merged };
-  }
-}
-
-function startPolling() {
-  const token = (process.env.FUNTIME_API_TOKEN || "").trim();
-  if (!token) {
-    console.warn("[events] FUNTIME_API_TOKEN is not set, /api/events will be empty.");
-    return;
-  }
-
-  let intervalMs = Number(process.env.FUNTIME_EVENTS_POLL_MS);
-  if (!Number.isFinite(intervalMs) || intervalMs < MIN_POLL_MS) {
-    intervalMs = DEFAULT_POLL_MS;
-  }
-
-  const run = () => {
-    poll(token).catch((error) => console.warn(`[events] poll failed: ${error.message}`));
-  };
-
-  run();
-  pollTimer = setInterval(run, intervalMs);
-  if (pollTimer.unref) pollTimer.unref();
-  console.log(`[events] relay polling every ${intervalMs}ms`);
-}
-
-function mount(app) {
-  app.get("/api/events", (req, res) => {
-    res.json(cache);
-  });
-  startPolling();
-}
-
-module.exports = { mount };
