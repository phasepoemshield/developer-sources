-      String anarchy = String.valueOf(data.getAnarchyNumber());
-      String loot = data.getLootTier().toLowerCase(Locale.ROOT);
-      return eventName.contains(query) || anarchy.contains(query) || ("an" + anarchy).contains(query) || loot.contains(query);
-   }
